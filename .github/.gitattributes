# ----------------------------------------
# PUNN Cognitive Architecture (PCA)
# Git Attributes
# ----------------------------------------

# Automatically normalize text files
* text=auto eol=lf

# Source code
*.py          text
*.md          text
*.txt         text
*.json        text
*.yaml        text
*.yml         text
*.toml        text
*.ini         text
*.cfg         text
*.sh          text
*.bat         text
*.ps1         text

# Documentation
*.rst         text
*.csv         text

# Images
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.svg         text

# Archives
*.zip         binary
*.tar         binary
*.gz          binary
*.7z          binary

# PDFs
*.pdf         binary

# Office Documents
*.docx        binary
*.pptx        binary
*.xlsx        binary

# Fonts
*.ttf         binary
*.otf         binary
*.woff        binary
*.woff2       binary
